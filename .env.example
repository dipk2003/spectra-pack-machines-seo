# Meta Lead Ads: required for native Facebook/Instagram instant-form leads.
# Generate your own random value and enter the SAME value in Meta's webhook setup.
META_LEAD_WEBHOOK_VERIFY_TOKEN=
# App secret from Meta for Developers (server-only).
META_APP_SECRET=
# Page access token with lead retrieval access for the subscribed Page (server-only).
META_LEADS_ACCESS_TOKEN=
# Graph API version, for example vXX.0. Use the version supported by your Meta app.
META_GRAPH_VERSION=

# Optional: campaign reporting in /admin/integrations (separate from lead capture).
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# Optional: alert when this percentage of an account-level spend cap remains.
META_SPEND_CAP_ALERT_PERCENT=10
OWNER_NOTIFICATION_EMAIL=

# Supabase project. The publishable key is safe for browser requests.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only key for admin and write operations. Never add NEXT_PUBLIC_ to it.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: Google Ads lead-form webhook (set the same key in Google Ads).
GOOGLE_ADS_LEAD_WEBHOOK_KEY=

# Optional: WhatsApp Business Cloud API webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
# Configure after Meta approves the template. Copy the exact name and language
# code (for example en_US) shown in WhatsApp Manager for the approved version.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
